{
  "description": "driftguard — 개념 지도 신선도 알림과 0건 구분 가드",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PLUGIN_ROOT\"/hooks/drift-notice.sh", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PLUGIN_ROOT\"/hooks/zero-guard.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
